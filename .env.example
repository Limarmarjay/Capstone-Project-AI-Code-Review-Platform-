# Copy this file to .env and fill in real values for local development.
# .env (and .env.*) is gitignored -- never commit real secrets. This file
# (.env.example) has no real values and is safe to commit.

# --- LLM (llm_review + repo_diff_pipeline's AI review step) ---
# Anthropic API key. Required to run with --real instead of the offline
# mock client: AnthropicLLMClient (llm_review/client.py) and
# repo_diff_pipeline/ai_reviewer.py both read this directly.
ANTHROPIC_API_KEY=
# Local Ollama request timeout in seconds (OllamaLLMClient / run_review.py
# --local --timeout). 14s was observed for a small single-file diff on an
# M4 MacBook Pro with Qwen2.5-Coder 7B; 300s (5 min) leaves generous
# headroom for much larger files. --timeout on the CLI overrides this;
# blank or non-numeric values fall back to 300 rather than crashing.
OLLAMA_TIMEOUT_SECONDS=300

# --- LLM API (llm_review/api.py -- standalone app for external teams) ---
# This is a SEPARATE app/process from the backend above: it's the only
# thing meant to be reachable from outside this machine (e.g. over a
# Tailscale tunnel). Run with: python -m llm_review.api
#
# Required. The app refuses to start without it -- there is no
# unauthenticated mode. Callers send it as the X-LLM-API-Key header.
LLM_API_KEY=
# Which Ollama model /api/llm/generate uses. Defaults to qwen2.5-coder:7b
# if unset.
LLM_API_MODEL=qwen2.5-coder:7b
# Per-request timeout for /api/llm/generate. Deliberately separate from
# OLLAMA_TIMEOUT_SECONDS above (that one's for the review pipeline/eval
# runner, which can take much longer per file) -- a plain-prompt API call
# should fail fast rather than hang for 5 minutes. Defaults to 60.
LLM_API_TIMEOUT_SECONDS=60
# Port the standalone app listens on. Defaults to 5100 if unset. This is
# the ONLY port that should ever be exposed via Tailscale/ngrok -- never
# Ollama's own port (11434).
LLM_API_PORT=5100
# Which network interface the app binds to. Defaults to 127.0.0.1
# (loopback-only -- reachable from this machine alone, even though the
# port is "open"). Set this to this Mac's Tailscale IP when you actually
# want another team to reach it -- never 0.0.0.0, which would bind every
# interface including any public one.
LLM_API_HOST=127.0.0.1

# --- GitHub ---
# Personal access token with repo read access, used by
# repo_diff_pipeline's --github-token / $GITHUB_TOKEN for PR ingestion.
GITHUB_TOKEN=
# OAuth app credentials used by backend/app/routes/github.py.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:5002/api/github/callback
FRONTEND_URL=http://localhost:5173

# --- Backend (Flask app: backend/app) ---
JWT_SECRET=
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=Capstone_Proj_Database
