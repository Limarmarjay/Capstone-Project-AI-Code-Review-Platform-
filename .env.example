# Copy this file to .env and fill in real values for local development.
# .env (and .env.*) is gitignored -- never commit real secrets. This file
# (.env.example) has no real values and is safe to commit.

# --- LLM (llm_review + repo_diff_pipeline's AI review step) ---
# Anthropic API key. Required to run with --real instead of the offline
# mock client: AnthropicLLMClient (llm_review/client.py) and
# repo_diff_pipeline/ai_reviewer.py both read this directly.
ANTHROPIC_API_KEY=
# Local Ollama request timeout in seconds (OllamaLLMClient / run_review.py
# --local --timeout). 14s was observed for a small single-file diff on an
# M4 MacBook Pro with Qwen2.5-Coder 7B; 300s (5 min) leaves generous
# headroom for much larger files. --timeout on the CLI overrides this;
# blank or non-numeric values fall back to 300 rather than crashing.
OLLAMA_TIMEOUT_SECONDS=300

# --- GitHub ---
# Personal access token with repo read access, used by
# repo_diff_pipeline's --github-token / $GITHUB_TOKEN for PR ingestion.
GITHUB_TOKEN=
# OAuth app credentials used by backend/app/routes/github.py.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:5002/api/github/callback
FRONTEND_URL=http://localhost:5173

# --- Backend (Flask app: backend/app) ---
JWT_SECRET=
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=Capstone_Proj_Database
